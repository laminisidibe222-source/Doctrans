name: Reset Monthly Translation Limits

on:
  schedule:
    # This cron syntax means "At 00:00 on day-of-month 1" (UTC time)
    - cron: '0 0 1 * *'
  # The 'workflow_dispatch' line allows you to run it manually for testing
  workflow_dispatch:

jobs:
  reset-limits:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger Backend Reset Endpoint
        run: |
          curl -X POST ${{ secrets.RENDER_APP_URL }}/api/cron/reset-limits \
          -H "Authorization: Bearer ${{ secrets.CRON_SECRET }}" \
          -H "Content-Type: application/json"